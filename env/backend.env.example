# Squad CRM backend — sample environment (CRM-107)
# Copy to `env/backend.env` (git-ignored) and adjust locally.
# Real values must never be committed.

ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5080

# PostgreSQL — consumed by docker-compose.yml (CRM-197).
# POSTGRES_HOST/POSTGRES_PORT are the *host-side* coordinates used by apps
# running directly on the developer machine. The container always listens on
# 5432 internally; POSTGRES_PORT only changes the published host port.
# Developer-safe local defaults. Never put a production credential here.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=squadcrm
POSTGRES_USER=squadcrm
POSTGRES_PASSWORD=change-me
# Compose-managed local volume. Override only for an intentionally isolated stack.
POSTGRES_VOLUME_NAME=squadcrm-pgdata

# Provider ports (kept empty here; adapters land in later stories)
AI_PROVIDER=none
EMAIL_PROVIDER=none
WHATSAPP_PROVIDER=none
SMS_PROVIDER=none
FILESTORAGE__PROVIDER=Local
FILESTORAGE__LOCALROOTPATH=.data/files
FILESTORAGE__MAXSIZEBYTES=10485760

# Optional OTLP export. Leave unset/empty to keep telemetry local to the process.
# Headers may contain secrets and belong only in the git-ignored env/backend.env.
OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_EXPORTER_OTLP_HEADERS=

# CORS allow-list consumed by SquadCrm.Api (ASP.NET Core array binding: __0, __1, ...)
CORS__AllowedOrigins__0=http://localhost:4200

# CRM-199 outbox delivery tuning (non-secret operational settings).
BACKGROUNDPROCESSING__ENABLED=true
BACKGROUNDPROCESSING__OUTBOX__BATCHSIZE=20
BACKGROUNDPROCESSING__OUTBOX__RETRYCEILING=5
BACKGROUNDPROCESSING__OUTBOX__LEASESECONDS=120
BACKGROUNDPROCESSING__OUTBOX__BACKOFFSECONDS=30
