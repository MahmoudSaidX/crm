# Backend-specific overrides only. The repository root `.editorconfig`
# (charset, line endings, indentation) still applies; nothing here duplicates it.

[*.cs]
# Namespaces: file-scoped throughout the backend.
csharp_style_namespace_declarations = file_scoped:error

# `var` usage: explicit where the type is not apparent from the right-hand side.
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = false:suggestion

# Modifier order and readonly-by-default.
dotnet_style_require_accessibility_modifiers = for_non_interface_members:error
dotnet_style_readonly_field = true:warning

