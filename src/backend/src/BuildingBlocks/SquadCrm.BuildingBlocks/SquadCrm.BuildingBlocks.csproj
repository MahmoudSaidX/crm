<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>SquadCrm.BuildingBlocks</RootNamespace>
  </PropertyGroup>

  <!-- Technical cross-cutting building blocks host ASP.NET Core abstractions
       (IServiceCollection, IEndpointRouteBuilder, IExceptionHandler, ProblemDetails).
       A FrameworkReference avoids pulling individual transitive packages. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

</Project>
