<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>SquadCrm.Api</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Hangfire.AspNetCore" Version="1.8.24" />
    <PackageReference Include="Hangfire.PostgreSql" Version="1.21.1" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
    <!-- Hangfire.PostgreSql permits an obsolete Newtonsoft.Json floor; pin the
         current stable release so restore cannot select the vulnerable 11.x. -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.18.0" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.18.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.18.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" Version="1.18.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" Version="1.18.0" />
  </ItemGroup>

  <!-- Composition root: references BuildingBlocks, the PostgreSQL configuration
       adapter and the module (implementation + contracts) purely to wire them
       up. No business rules and no EF Core live here. -->
  <ItemGroup>
    <ProjectReference Include="../../BuildingBlocks/SquadCrm.BuildingBlocks/SquadCrm.BuildingBlocks.csproj" />
    <ProjectReference Include="../../Infrastructure/SquadCrm.Infrastructure.Postgres/SquadCrm.Infrastructure.Postgres.csproj" />
    <ProjectReference Include="../../Infrastructure/SquadCrm.Infrastructure.FileStorage/SquadCrm.Infrastructure.FileStorage.csproj" />
    <ProjectReference Include="../../Modules/ArchitectureFixture/SquadCrm.Modules.ArchitectureFixture/SquadCrm.Modules.ArchitectureFixture.csproj" />
    <ProjectReference Include="../../Modules/ArchitectureFixture/SquadCrm.Modules.ArchitectureFixture.Contracts/SquadCrm.Modules.ArchitectureFixture.Contracts.csproj" />
    <ProjectReference Include="../../Modules/StaffIdentity/SquadCrm.Modules.StaffIdentity/SquadCrm.Modules.StaffIdentity.csproj" />
    <ProjectReference Include="../../Modules/RoleManagement/SquadCrm.Modules.RoleManagement/SquadCrm.Modules.RoleManagement.csproj" />
    <ProjectReference Include="../../Modules/Audit/SquadCrm.Modules.Audit/SquadCrm.Modules.Audit.csproj" />
    <ProjectReference Include="../../Modules/DepartmentManagement/SquadCrm.Modules.DepartmentManagement/SquadCrm.Modules.DepartmentManagement.csproj" />
    <ProjectReference Include="../../Modules/SystemConfiguration/SquadCrm.Modules.SystemConfiguration/SquadCrm.Modules.SystemConfiguration.csproj" />
  </ItemGroup>

</Project>
