{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "BackgroundProcessing": {
    "Enabled": true,
    "Outbox": {
      "BatchSize": 20,
      "RetryCeiling": 5,
      "LeaseSeconds": 120,
      "BackoffSeconds": 30
    }
  },
  "AllowedHosts": "*"
}
