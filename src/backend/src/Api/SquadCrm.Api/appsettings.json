{
  "FileStorage": {
    "Provider": "Local",
    "LocalRootPath": ".data/files",
    "MaxSizeBytes": 10485760,
    "AllowedContentTypes": [
      "application/pdf",
      "image/jpeg",
      "image/png",
      "text/plain"
    ]
  },
  "Logging": {
    "Console": {
      "FormatterName": "json",
      "FormatterOptions": {
        "IncludeScopes": true,
        "UseUtcTimestamp": true
      }
    },
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "BackgroundProcessing": {
    "Enabled": true,
    "Outbox": {
      "BatchSize": 20,
      "RetryCeiling": 5,
      "LeaseSeconds": 120,
      "BackoffSeconds": 30
    }
  },
  "AllowedHosts": "*"
}
