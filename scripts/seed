#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
repo_root="$(cd "$script_dir/.." && pwd)"
seed_file="$repo_root/src/backend/src/Modules/ArchitectureFixture/SquadCrm.Modules.ArchitectureFixture/Persistence/DevelopmentSeed.sql"
backend_env_file="${SQUADCRM_BACKEND_ENV_FILE:-$repo_root/env/backend.env}"

if [[ -f "$backend_env_file" ]]; then
  set -a
  # shellcheck disable=SC1091
  source "$backend_env_file"
  set +a
fi

export POSTGRES_DB="${POSTGRES_DB:-squadcrm}"
export POSTGRES_USER="${POSTGRES_USER:-squadcrm}"

cd "$repo_root"
docker compose exec -T postgres \
  psql --set ON_ERROR_STOP=1 --username "$POSTGRES_USER" --dbname "$POSTGRES_DB" \
  < "$seed_file"
